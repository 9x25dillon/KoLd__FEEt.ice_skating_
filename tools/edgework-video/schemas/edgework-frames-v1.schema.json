{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgework.local/schemas/edgework-frames-v1.schema.json",
  "title": "edgework-frames/1",
  "description": "Per-frame PTS timeline derived from ffprobe by edgework-video intake.",
  "type": "object",
  "required": [
    "schema",
    "sourceSha256",
    "streamIndex",
    "timeBase",
    "nominalFps",
    "frameCount",
    "vfr",
    "vfrThresholdFraction",
    "medianDurationSec",
    "rotationDeg",
    "fieldOrder",
    "interlaced",
    "frames"
  ],
  "properties": {
    "schema": { "const": "edgework-frames/1" },
    "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "streamIndex": { "type": "integer", "minimum": 0 },
    "timeBase": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
    "nominalFps": { "type": "number", "exclusiveMinimum": 0 },
    "frameCount": { "type": "integer", "minimum": 1 },
    "vfr": { "type": "boolean" },
    "vfrThresholdFraction": { "type": "number", "minimum": 0 },
    "medianDurationSec": { "type": ["number", "null"] },
    "rotationDeg": { "type": "number" },
    "fieldOrder": { "type": "string" },
    "interlaced": { "type": "boolean" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "pts", "timeBase", "tExact", "tSec", "durationPts", "durationSec", "keyFrame", "interlacedFrame", "topFieldFirst"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "pts": { "type": "integer" },
          "timeBase": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
          "tExact": { "type": "string" },
          "tSec": { "type": "number" },
          "durationPts": { "type": ["integer", "null"] },
          "durationSec": { "type": ["number", "null"] },
          "keyFrame": { "type": "boolean" },
          "interlacedFrame": { "type": "boolean" },
          "topFieldFirst": { "type": "boolean" }
        }
      }
    }
  }
}
