    },
    {
      "id": "hop",
      "name": "Hop",
      "pre":  { "foot": "any", "edge": "any", "forward": "any" },
      "post": { "foot": "any", "edge": "any", "forward": "any" },
      "heading_delta_deg": 0, "arc_length_m": 2.0, "speed_delta": -0.5,
      "stamina_legs": 0.022, "stamina_wind": 0.007, "turn_tag": null,
      "authored": true, "repeatable": false,
      "notes": "A free state-reset. Expensive in stamina but can flip foot, edge and direction at once, so the solver reaches for it when docking is otherwise impossible."
    }
  ]
}
