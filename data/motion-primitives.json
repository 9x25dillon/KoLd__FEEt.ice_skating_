    },
    {
      "id": "lunge",
      "name": "Lunge",
      "pre":  { "foot": "any", "edge": "any", "forward": true },
      "post": { "foot": "same", "edge": "any", "forward": true },
      "heading_delta_deg": 15, "arc_length_m": 4.0, "speed_delta": -1.3,
      "stamina_legs": 0.010, "stamina_wind": 0.006, "turn_tag": null,
